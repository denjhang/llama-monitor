QMainWindow { background-color: #0e0f13; }
#root { background-color: #0e0f13; }
QLabel { background: transparent; color: #d4d7e0; font-family: 'Microsoft YaHei UI'; font-size: 12px; }
QFrame[class="card"] { background: #16181f; border: 1px solid #22252e; border-radius: 4px; }
QFrame[class="tile"] { background: #16181f; border: 1px solid #22252e; border-radius: 4px; }
QLabel[class="cap"]  { color: #cdd3e0; font-size: 10px; letter-spacing: 1px; }
QLabel[class="kpi"]  { color: #f0f2f8; font-size: 19px; font-weight: 700; }
QLabel[class="kpi_s"]{ color: #d5dae4; font-size: 13px; font-weight: 600; }
QLabel[class="dim"]  { color: #b8bfcc; font-size: 11px; }
QLabel[class="big"]  { color: #f2f4f9; font-size: 14px; font-weight: 600; }
QLabel[class="pill_ok"]   { color: #43d17c; background: #12271c; border: 1px solid #1f7a4d;
                   border-radius: 0px; padding: 2px 10px; font-size: 11px; font-weight: 700; }
QLabel[class="pill_warn"] { color: #ffc95c; background: #2a2113; border: 1px solid #a97a1f;
                   border-radius: 0px; padding: 2px 10px; font-size: 11px; font-weight: 700; }
QLabel[class="pill_bad"]  { color: #ff7b7b; background: #2a1414; border: 1px solid #b03a3a;
                   border-radius: 0px; padding: 2px 10px; font-size: 11px; font-weight: 700; }
QProgressBar { background: #23262f; border: none; border-radius: 5px; height: 12px; text-align: center;
               color: #cfd3dc; font-size: 10px; }
QProgressBar::chunk { background: qlineargradient(x1:0,y1:0,x2:1,y2:0, stop:0 #4f8cff, stop:1 #7db1ff);
                      border-radius: 5px; }
QTableWidget { background: #16181f; border: none; gridline-color: #1c1f27;
               alternate-background-color: #191b23; font-size: 11px; }
QTableWidget::item { padding: 1px 5px; }
QHeaderView::section { background: transparent; color: #aab1c0; border: none;
                       border-bottom: 1px solid #2a2d38; padding: 2px 5px; font-size: 11px; }
QTextEdit { background: #0b0c10; border: 1px solid #22252e; border-radius: 4px;
            font-family: 'Consolas'; font-size: 11px; color: #8fd694; padding: 6px 8px; }

QPushButton { background: #1f2937; color: #d5dae4; border: 1px solid #3a4252;
              border-radius: 4px; padding: 3px 12px; font-size: 11px; }
QPushButton:hover { background: #2a3550; color: #fff; }
QPushButton:pressed { background: #4f8cff; color: #fff; }

QLabel[class="toast"] { color: #43d17c; background: #12271c; border: 1px solid #1f7a4d;
                   border-radius: 4px; padding: 3px 10px; font-size: 11px; font-weight: 700; }

QLabel[class="dog"] { color: #0e0f13; background: #6f9bff; border-radius: 4px;
                   padding: 2px 10px; font-size: 11px; font-weight: 700; }
QLabel[class="dog_lucky"] { color: #0e0f13; background: #3ddc84; border-radius: 4px;
                   padding: 2px 10px; font-size: 11px; font-weight: 700; }
QLabel[class="dog_revive"] { color: #0e0f13; background: #d9a021; border-radius: 4px;
                   padding: 2px 10px; font-size: 11px; font-weight: 700; }
QLabel[class="stat"] { color: #cdd3e0; font-size: 11px; }
